# These are examples only. Export variables in the shell; the app does not load .env automatically.
# Create the database first, then run: go run ./cmd/migrate
# Leave RENT_MYSQL_DSN unset to disable persistence.
RENT_MYSQL_DSN=rental_app:replace_with_password@tcp(127.0.0.1:3306)/house_rent
# Optional queue directory; defaults to the OS user config directory / house-rent-table/persistence.
# RENT_PERSISTENCE_DIR=D:/private/house-rent-queue
# Explicit default for ambiguous currency; empty disables the default.
RENT_DEFAULT_CURRENCY=CNY
