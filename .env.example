# 复制为 .env 后填写本机凭据；服务和迁移命令自动读取当前工作目录的 .env。
# .env 已被 Git 忽略，此示例文件只保留占位值，不填写真实密码。
# 已存在的环境变量优先（包括空值）；设置 RENT_MYSQL_DSN='' 可关闭后台保存与坑人反馈保存。
# 先创建数据库，再运行 go run ./cmd/migrate。
# 单引号可原样保留密码里的 $、# 等字符。
RENT_MYSQL_DSN='rental_app:replace_with_password@tcp(127.0.0.1:3306)/house_rent'
# 可选队列目录，默认位于系统用户配置目录的 house-rent-table/persistence。
# RENT_PERSISTENCE_DIR=D:/private/house-rent-queue
# 默认币种；空值表示不提供默认币种。
RENT_DEFAULT_CURRENCY=CNY
