# 复制为 .env 后填写本机凭据；服务和迁移命令自动读取当前工作目录的 .env。
# .env 已被 Git 忽略，此示例文件只保留占位值，不填写真实密码。
# 已存在的环境变量优先（包括空值）；设置 RENT_MYSQL_DSN='' 可关闭后台保存与坑人反馈保存。
# 先创建数据库，再运行 go run ./cmd/migrate。
# 单引号可原样保留密码里的 $、# 等字符。
RENT_MYSQL_DSN='rental_app:replace_with_password@tcp(127.0.0.1:3306)/house_rent'
# 可选队列目录，默认位于系统用户配置目录的 house-rent-table/persistence。
# RENT_PERSISTENCE_DIR=D:/private/house-rent-queue
# 默认币种；空值表示不提供默认币种。
RENT_DEFAULT_CURRENCY=CNY

# 可选：MiMo 搜索插件未开通时，由服务端统一提供备用搜索。
# 两项均不设置时禁用；只设置 Key 时默认 glm。provider 只支持 glm / deepseek。
# Key 必须属于所选搜索供应商，并具有其搜索 API 权限；不要填写 MiMo Key。
# 用户页面仍只填写自己的模型 Key；搜索费用由此服务端账号承担。
# 修改后重启服务。以下只是占位示例，不包含真实凭据。
# RENT_SEARCH_PROVIDER=glm
# RENT_SEARCH_API_KEY='replace_with_search_provider_key'

# 每次分析实际发送的独立搜索次数上限，默认 24，支持 1 至 100。
# 适用于 GLM、DeepSeek 和 MiMo 备用搜索；不是供应商账号配额。
# 相同查询的成功结果在本次分析内复用；参数无效不计数，已发送的失败请求计数。
# 调高可能增加搜索费用；主分析仍受 5 分钟超时约束。修改后重启服务。
# RENT_SEARCH_MAX_CALLS=48
